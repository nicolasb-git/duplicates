#!/bin/bash

# Path to the source code (resolves correctly even if symlinked)
SOURCE_DIR="$(cd "$(dirname "$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")")" && pwd)"

# Check if python3 is installed
if ! command -v python3 &> /dev/null
then
    echo "Error: python3 could not be found. Please install Python."
    exit 1
fi

# Run the tool
python3 "$SOURCE_DIR/main.py" "$@"
